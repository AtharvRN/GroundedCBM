{
  "model_name": "savlg_cbm",
  "dataset": "cub",
  "concept_set": "concept_files/cub_filtered.txt",
  "backbone": "resnet50_cub_mm",
  "annotation_dir": "/path/to/cub_annotations",
  "save_dir": "artifacts/cub",
  "device": "cuda",
  "num_workers": 10,
  "mask_h": 14,
  "mask_w": 14,
  "seed": 6885,
  "cbl_epochs": 10,
  "cbl_batch_size": 32,
  "saga_batch_size": 256,
  "saga_n_iters": 4000,
  "saga_lam": 0.0002,
  "saga_step_size": 0.1,
  "savlg_branch_arch": "dual",
  "savlg_spatial_stage": "conv5",
  "savlg_spatial_branch_mode": "multiscale_conv45",
  "savlg_local_loss_mode": "soft_align",
  "savlg_target_mode": "soft_box",
  "savlg_residual_spatial_alpha": 0.2,
  "savlg_residual_spatial_pooling": "lse",
  "savlg_outside_penalty_w": 0.0,
  "skip_test_eval": false
