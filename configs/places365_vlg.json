{
  "model_name": "vlg_cbm",
  "dataset": "places365",
  "concept_set": "concept_files/places365_filtered.txt",
  "backbone": "resnet50",
  "feature_layer": "layer4",
  "annotation_dir": "/path/to/places365_annotations",
  "save_dir": "artifacts/places365",
  "device": "cuda",
  "num_workers": 8,
  "val_split": 0.05,
  "crop_to_concept_prob": 0.5,
  "cbl_confidence_threshold": 0.15,
  "cbl_hidden_layers": 1,
  "cbl_batch_size": 128,
  "cbl_epochs": 4,
  "cbl_lr": 0.0005,
  "cbl_pos_weight": 50.0,
  "saga_batch_size": 512,
  "saga_step_size": 0.1,
  "saga_lam": 0.0007,
  "saga_n_iters": 100,
  "seed": 42
}
